# URL of the Google Apps Script Web App that appends a row to your response sheet.
# See README.md -> "Response logging (Google Sheet)" for the script and deploy steps.
GOOGLE_SHEET_WEBHOOK_URL=

# Optional shared secret. If set here, it must match the SECRET constant in the
# Apps Script. Requests without the matching token are rejected by the script.
GOOGLE_SHEET_WEBHOOK_SECRET=
