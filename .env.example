# URL of the Google Apps Script Web App (its /exec URL). ONE deployment serves
# both jobs:
#   - POST: append a survey response as a sheet row
#   - GET ?content=all: return the editable content for the build-time pull
# See README.md -> "Response logging" and "Editing content in the Google Sheet".
GOOGLE_SHEET_WEBHOOK_URL=

# Optional shared secret for POSTs. If set here, it must match the SECRET
# constant in Code.gs. (GET content is not secret and ignores this.)
GOOGLE_SHEET_WEBHOOK_SECRET=

# Optional. Only set this if the build should pull content from a DIFFERENT URL
# than GOOGLE_SHEET_WEBHOOK_URL. Normally leave blank — pull-content.mjs falls
# back to GOOGLE_SHEET_WEBHOOK_URL.
CONTENT_SOURCE_URL=
